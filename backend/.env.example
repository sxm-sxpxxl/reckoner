# Шаблон переменных окружения бэкенда.
# Скопировать в backend/.env и подставить настоящие значения.
# backend/.env закрыт .gitignore и в репозиторий не попадает.
#
# Как получить строки подключения — docs/setup-neon.md
#
# Требования к строкам:
#   - бранч dev для DATABASE_URL, бранч test для TEST_DATABASE_URL;
#   - в имени хоста НЕ должно быть "-pooler" (нужен прямой эндпоинт: pooled — это
#     PgBouncer в transaction mode, он ломает подготовленные запросы sqlx);
#   - параметр channel_binding=require из строки убрать, оставить ?sslmode=require;
#   - без кавычек, без пробелов вокруг "=", по одной переменной на строку;
#   - хосты у dev и test обязаны различаться.

DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ-БРАНЧА-DEV.eu-central-1.aws.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL=postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ-БРАНЧА-TEST.eu-central-1.aws.neon.tech/neondb?sslmode=require
